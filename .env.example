# PostgreSQL (local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atelier_store

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# Public base URL used by the auth client
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (use a sandbox; a restricted key rk_… with Checkout Sessions write access is enough)
STRIPE_SECRET_KEY=rk_test_replace-me
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`, or the Dashboard endpoint
STRIPE_WEBHOOK_SECRET=whsec_replace-me
